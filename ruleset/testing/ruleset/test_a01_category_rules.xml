<!-- A-01 legacy category dispatch fixture. Do not rewrite expected behavior in A-02+. -->
<group name="qa,a01_category,">
  <!-- Implicit attachment to root 1 via SYSLOG category. -->
  <rule id="999950" level="8">
    <category>syslog</category>
    <decoded_as>qa_a01_syslog</decoded_as>
    <match>^A01_SYSLOG</match>
    <description>A-01 syslog category parent.</description>
  </rule>

  <rule id="999951" level="11">
    <if_sid>999950</if_sid>
    <match>^A01_SYSLOG_CHILD$</match>
    <description>A-01 explicit if_sid child.</description>
  </rule>

  <!-- A rule without category is a SYSLOG-category rule in 4.14.12. -->
  <rule id="999952" level="7">
    <decoded_as>qa_a01_syslog</decoded_as>
    <match>^A01_IMPLICIT$</match>
    <description>A-01 implicit syslog category.</description>
  </rule>

  <rule id="999953" level="9">
    <category>ids</category>
    <decoded_as>qa_a01_ids</decoded_as>
    <match>^A01_IDS</match>
    <description>A-01 IDS category parent.</description>
  </rule>

  <!-- Higher priority, matching decoded_as, but deliberately unreachable from IDS root. -->
  <rule id="999954" level="15">
    <category>syslog</category>
    <decoded_as>qa_a01_ids</decoded_as>
    <match>^A01_IDS$</match>
    <description>A-01 cross-category exclusion decoy.</description>
  </rule>

  <rule id="999955" level="11">
    <if_sid>999953</if_sid>
    <match>^A01_IDS_CHILD$</match>
    <description>A-01 inherited category through if_sid.</description>
  </rule>

  <!-- Built-in firewall rule 4100 is under root 2 and itself returns level zero. -->
  <rule id="999956" level="8">
    <if_sid>4100</if_sid>
    <category>firewall</category>
    <decoded_as>qa_a01_firewall</decoded_as>
    <match>^A01_FIREWALL$</match>
    <description>A-01 firewall rule reachable under built-in 4100.</description>
  </rule>

  <!-- A matching noalert parent with no successful child must yield NULL. -->
  <rule id="999957" level="0" noalert="1">
    <category>syslog</category>
    <decoded_as>qa_a01_syslog</decoded_as>
    <match>^A01_FALLBACK</match>
    <description>A-01 noalert parent.</description>
  </rule>

  <rule id="999958" level="12">
    <if_sid>999957</if_sid>
    <match>^A01_FALLBACK_CHILD$</match>
    <description>A-01 successful descendant of noalert.</description>
  </rule>

  <rule id="999959" level="5">
    <category>syslog</category>
    <decoded_as>qa_a01_syslog</decoded_as>
    <match>^A01_FALLBACK$</match>
    <description>A-01 sibling selected after noalert returns NULL.</description>
  </rule>

  <rule id="999960" level="0">
    <if_sid>999950</if_sid>
    <match>^A01_SYSLOG_ZERO$</match>
    <description>A-01 level-zero child suppresses parent.</description>
  </rule>

  <!-- One RuleInfo is inserted under two different matching parents. -->
  <rule id="999961" level="12">
    <if_sid>999950,999953</if_sid>
    <match>SHARED$</match>
    <description>A-01 multiple if_sid placements.</description>
  </rule>
</group>
